# extractly environment variables
# Copy this file to .env.local and fill in one of the options below.

# Option A (recommended): Vercel AI Gateway.
# Get a key at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# Not needed when deployed on Vercel -- OIDC covers it automatically.
AI_GATEWAY_API_KEY=

# Option B: call Anthropic directly, bypassing the AI Gateway.
# Used automatically as a fallback if AI_GATEWAY_API_KEY is not set.
ANTHROPIC_API_KEY=
